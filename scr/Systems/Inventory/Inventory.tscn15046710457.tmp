[sub_resource type="GDScript" id="GDScript_uh2ii"]
script/source = "extends Node
class_name CraftingManager2

@export var inventory: Inventory
@export var simple_recipes: Array[CraftingRecipe] = []  # Ручной крафт (без станции)
@export var workbench_recipes: Array[CraftingRecipe] = []  # Верстак
@export var kotel_recipes: Array[CraftingRecipe] = []  # Котёл
@export var anvil_recipes: Array[CraftingRecipe] = []  # Наковальня (пример)

signal crafted(item: ItemData, amount: int)
signal recipes_updated(station: String)

var current_station: String = \"\"  # Текущая станция

func _ready() -> void:
	if not inventory:
		inventory = get_tree().get_first_node_in_group(\"Inventory\")
	if inventory:
		inventory.inventory_changed.connect(_on_inventory_changed)
		print(\"CraftingManager подключён к инвентарю\")

func set_current_station(station: String) -> void:
	current_station = station.to_lower()
	_update_recipes_ui()
	print(\"Текущая станция: \", current_station)

func get_available_recipes() -> Array[CraftingRecipe]:  # Все рецепты станции
	var all_recipes: Array[CraftingRecipe] = []
	match current_station:
		\"workbench\":
			all_recipes = workbench_recipes
		\"kotel\":
			all_recipes = kotel_recipes
		\"anvil\":
			all_recipes = anvil_recipes
		_:
			all_recipes = simple_recipes
	
	# Сортировка: сначала доступные
	all_recipes.sort_custom(func(a, b):
		var can_a = can_craft(a)
		var can_b = can_craft(b)
		if can_a != can_b:
			return can_a  # Доступные первыми
		return a.output_item.item_name.nocasecmp_to(b.output_item.item_name) < 0  # Исправлено: item_name
	)
	
	return all_recipes

func can_craft(recipe: CraftingRecipe) -> bool:
	if not inventory or (recipe.require_station != current_station and recipe.require_station != \"\"):
		return false
	for ingredient in recipe.inputs:
		var current_count = inventory.get_item_count(ingredient.InputItem.item_name)  # Исправлено: item_name
		if current_count < ingredient.InputAmmout:
			return false
	return true

func craft(recipe: CraftingRecipe) -> bool:
	if not can_craft(recipe):
		print(\"Нельзя крафтить: Недостаточно ресурсов для \", recipe.output_item.item_name)  # Исправлено: item_name
		return false
	
	# Удаляем ингредиенты
	for ingredient in recipe.inputs:
		var item = ingredient.InputItem
		var amount = ingredient.InputAmmout
		print(\"Удаляем \", amount, \" шт. \", item.item_name)  # Исправлено: item_name
		inventory.remove_item(item, amount)
	
	# Добавляем результат
	var output = recipe.output_item.duplicate()
	var output_amount = recipe.output_amount
	print(\"Добавляем \", output_amount, \" шт. \", output.item_name)  # Исправлено: item_name
	inventory.add_item(output, output_amount)
	
	emit_signal(\"crafted\", output, output_amount)
	_update_recipes_ui()
	return true

func _on_inventory_changed() -> void:
	print(\"Инвентарь изменился, обновляем UI крафта\")
	_update_recipes_ui()

func _update_recipes_ui() -> void:
	emit_signal(\"recipes_updated\", current_station)
"

